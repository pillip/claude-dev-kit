+        assert exit_code == sq.ROSTER_BOUNDARY_EXIT
+        assert out["roster_boundary"]["state"] == "rejected"
+        assert "is above the highest Board id" in out["roster_boundary"]["detail"]
+
+        typo = tmp_path / "issues_m4_typo_TYPO.md"
