+        assert rc == 1
+        assert "styles.css" in out
+
+    def test_class_token_match_is_not_substring(self, proto, capsys):
+        # signature-ledger-rule-xl must NOT satisfy signature-ledger-rule.
+        _mutate(
+            proto / "prototype/screens/home.html",
